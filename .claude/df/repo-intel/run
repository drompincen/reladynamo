#!/bin/bash
# drom-flow — private repository-intelligence runtime wrapper.
#
# Not a user command. drom-flow's hooks and skills call this; host users never see it.
#
# Execution mode is chosen for cost, not for purity:
#   1. cached classes  — a warm query is a bare JVM start, no compiler, no network
#   2. javac           — compile once into gitignored state, then mode 1 forever
#   3. jbang           — used when there is no JDK; jbang can provision its own
#   4. jbang bootstrap — one attempt, recorded, never retried in a loop
#   5. unavailable     — emit a structured "fall back to source search" and exit 3
#
# Anything that fails here must degrade, never break the session.

set -uo pipefail

SRC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="${CLAUDE_PROJECT_DIR:-$(cd "$SRC_DIR/../../.." && pwd)}"
ROOT="$(cd "$ROOT" && pwd)"
# State location is configurable; see .claude/hooks/repo-intel-path.sh for the contract.
if [ -f "$ROOT/.claude/hooks/repo-intel-path.sh" ]; then
  . "$ROOT/.claude/hooks/repo-intel-path.sh"
  STATE="$(repo_intel_state_dir "$ROOT")"
else
  STATE="${DROMFLOW_REPO_INTEL_STATE:-$ROOT/.claude/.state/repo-intel}"
fi
[ -f "$ROOT/VERSION" ] && export DROMFLOW_VERSION="$(tr -d '[:space:]' < "$ROOT/VERSION" 2>/dev/null)"
CLASSES="$STATE/classes"
UNAVAIL="$STATE/unavailable.json"
UNAVAIL_TTL="${DROMFLOW_REPO_INTEL_RETRY_SECS:-21600}"   # 6h: do not re-probe a broken toolchain every query
JAVA_RELEASE="${DROMFLOW_REPO_INTEL_JAVA_RELEASE:-21}"

mkdir -p "$STATE" 2>/dev/null || true

emit_unavailable() { # reason
  local reason="$1"
  printf '{"ok":false,"command":"unavailable","error":{"code":"engine_unavailable","message":%s},"results":[],"truncated":false}\n' \
    "\"$(printf '%s' "$reason" | sed 's/\\/\\\\/g; s/"/\\"/g')\""
  printf '{"state":"unavailable","reason":"%s","ts":%s}\n' "$(printf '%s' "$reason" | sed 's/"/\\"/g')" "$(date +%s)" \
    > "$UNAVAIL" 2>/dev/null || true
  exit 3
}

# A previous probe already established that this machine cannot run the engine. Say so cheaply.
if [ -f "$UNAVAIL" ] && [ "${DROMFLOW_REPO_INTEL_FORCE_PROBE:-0}" != "1" ]; then
  ts=$(sed -n 's/.*"ts":\([0-9]*\).*/\1/p' "$UNAVAIL" 2>/dev/null)
  now=$(date +%s)
  if [ -n "$ts" ] && [ $((now - ts)) -lt "$UNAVAIL_TTL" ]; then
    reason=$(sed -n 's/.*"reason":"\([^"]*\)".*/\1/p' "$UNAVAIL" 2>/dev/null)
    printf '{"ok":false,"command":"unavailable","error":{"code":"engine_unavailable","message":"%s (cached)"},"results":[],"truncated":false}\n' \
      "${reason:-unknown}"
    exit 3
  fi
  rm -f "$UNAVAIL"
fi

find_java() {
  if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then echo "$JAVA_HOME/bin/java"; return 0; fi
  command -v java 2>/dev/null && return 0
  return 1
}
find_javac() {
  if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/javac" ]; then echo "$JAVA_HOME/bin/javac"; return 0; fi
  command -v javac 2>/dev/null && return 0
  return 1
}
find_jbang() {
  command -v jbang 2>/dev/null && return 0
  [ -x "$HOME/.jbang/bin/jbang" ] && { echo "$HOME/.jbang/bin/jbang"; return 0; }
  [ -x "$STATE/jbang/bin/jbang" ] && { echo "$STATE/jbang/bin/jbang"; return 0; }
  return 1
}

# --- Windows JVM reached from WSL -------------------------------------------------
# A very common developer setup is WSL with the JDK installed on Windows. That JVM is a
# Windows process: it cannot see /home or /tmp, and every path handed to it must be a
# Windows path. Detect it once and translate, rather than failing in a way that looks
# like a bug in the engine.
IS_WIN_JVM=0
detect_win_jvm() {
  local j="$1"
  case "$j" in *.exe) IS_WIN_JVM=1; return ;; esac
  if [ -f "$j" ] && head -c 400 "$j" 2>/dev/null | grep -q '\.exe'; then IS_WIN_JVM=1; return; fi
  case "$(readlink -f "$j" 2>/dev/null)" in /mnt/[a-z]/*) IS_WIN_JVM=1 ;; esac
}
wpath() {
  if [ "$IS_WIN_JVM" = 1 ]; then wslpath -w "$1" 2>/dev/null || echo "$1"; else echo "$1"; fi
}

# Source stamp: recompile only when the engine sources actually change.
src_stamp() {
  ( cd "$SRC_DIR" && ls -la *.java 2>/dev/null | cksum ) | tr -d ' '
}

MODE=""
JAVA="$(find_java || true)"
JAVAC="$(find_javac || true)"
[ -n "$JAVA" ] && detect_win_jvm "$JAVA"

# A Windows JVM cannot reach a WSL-native project at all. Say why instead of half-working.
if [ "$IS_WIN_JVM" = 1 ]; then
  case "$ROOT" in
    /mnt/[a-z]/*) : ;;
    *) emit_unavailable "the only JVM found is a Windows binary, but the project lives on a WSL-native path it cannot read" ;;
  esac
fi

if [ -n "$JAVA" ]; then
  stamp="$(src_stamp)"
  if [ -f "$CLASSES/.stamp" ] && [ "$(cat "$CLASSES/.stamp" 2>/dev/null)" = "$stamp" ] && [ -f "$CLASSES/RepoIntel.class" ]; then
    MODE="cached"
  elif [ -n "$JAVAC" ]; then
    rm -rf "$CLASSES" 2>/dev/null
    mkdir -p "$CLASSES" 2>/dev/null
    _srcs=(); for _f in "$SRC_DIR"/*.java; do _srcs+=("$(wpath "$_f")"); done
    if "$JAVAC" --release "$JAVA_RELEASE" -nowarn -d "$(wpath "$CLASSES")" "${_srcs[@]}" 2>"$STATE/compile.log"; then
      printf '%s' "$stamp" > "$CLASSES/.stamp"
      MODE="compiled"
    else
      MODE=""
    fi
  fi
fi

if [ -z "$MODE" ]; then
  JBANG="$(find_jbang || true)"
  if [ -z "$JBANG" ] && [ "${DROMFLOW_REPO_INTEL_NO_NETWORK:-0}" != "1" ] && [ ! -f "$STATE/jbang-bootstrap-failed" ]; then
    if command -v curl >/dev/null 2>&1; then
      ( timeout 120 bash -c 'curl -Ls https://sh.jbang.dev | bash -s - app setup' >"$STATE/jbang-bootstrap.log" 2>&1 ) || true
    fi
    JBANG="$(find_jbang || true)"
    [ -z "$JBANG" ] && : > "$STATE/jbang-bootstrap-failed"
  fi
  if [ -n "$JBANG" ]; then
    MODE="jbang"
  fi
fi

case "$MODE" in
  cached|compiled)
    printf '{"mode":"%s","java":"%s","ts":%s}\n' "$MODE" "$JAVA" "$(date +%s)" > "$STATE/runtime.json" 2>/dev/null || true
    [ "${1:-}" = "--probe" ] && { cat "$STATE/runtime.json"; exit 0; }
    export DROMFLOW_REPO_INTEL_ENGINE_STAMP="$(src_stamp)"
    # A Windows JVM has no access to WSL's git, so the file list is computed here and
    # handed over; the engine still validates every path it is given.
    if [ "$IS_WIN_JVM" = 1 ] && command -v git >/dev/null 2>&1 \
       && git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
      git -C "$ROOT" ls-files -co --exclude-standard -z > "$STATE/filelist" 2>/dev/null \
        && export DROMFLOW_REPO_INTEL_FILELIST="$(wpath "$STATE/filelist")"
    fi
    exec "$JAVA" -XX:TieredStopAtLevel=1 -XX:+UseSerialGC -Xshare:auto \
         -cp "$(wpath "$CLASSES")" RepoIntel "$@" --root "$(wpath "$ROOT")" --state "$(wpath "$STATE")"
    ;;
  jbang)
    printf '{"mode":"jbang","jbang":"%s","ts":%s}\n' "$JBANG" "$(date +%s)" > "$STATE/runtime.json" 2>/dev/null || true
    [ "${1:-}" = "--probe" ] && { cat "$STATE/runtime.json"; exit 0; }
    export DROMFLOW_REPO_INTEL_ENGINE_STAMP="$(src_stamp)"
    exec "$JBANG" run "$SRC_DIR/RepoIntel.java" "$@" --root "$ROOT" --state "$STATE"
    ;;
  *)
    if [ -z "$JAVA" ]; then emit_unavailable "no JVM found on PATH or JAVA_HOME, and JBang could not be provisioned"
    elif [ -z "$JAVAC" ]; then emit_unavailable "a JRE is present but no javac, and JBang could not be provisioned"
    else emit_unavailable "engine compilation failed; see .claude/.state/repo-intel/compile.log"; fi
    ;;
esac
