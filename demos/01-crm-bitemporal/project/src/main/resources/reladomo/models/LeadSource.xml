<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<MithraObject objectType="transactional"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="reladomoobject.xsd">
        <PackageName>com.reladynamo.demo.crm.domain</PackageName>
        <ClassName>LeadSource</ClassName>
        <DefaultTable>LEAD_SOURCE</DefaultTable>
        <Attribute name="sourceCode" javaType="String" columnName="SOURCE_CODE" primaryKey="true" maxLength="32"/>
        <Attribute name="name" javaType="String" columnName="NAME" maxLength="128"/>
        <Attribute name="channel" javaType="String" columnName="CHANNEL" maxLength="32"/>
</MithraObject>
