<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<MithraObject objectType="transactional" disableForeignKeys="true"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="mithraobject.xsd">
    <PackageName>com.reladynamo.demo.petstore.domain</PackageName>
    <ClassName>VeterinaryVisit</ClassName>
        <DatedTransactionalTemporalDirector>com.gs.fw.common.mithra.behavior.AuditOnlyTemporalDirector</DatedTransactionalTemporalDirector>
    <DefaultTable>VETERINARY_VISIT</DefaultTable>
    <AsOfAttribute name="processingDate" fromColumnName="IN_Z" toColumnName="OUT_Z"
                   toIsInclusive="false" isProcessingDate="true"
                   infinityDate="[com.gs.fw.common.mithra.util.DefaultInfinityTimestamp.getDefaultInfinity()]"
                   defaultIfNotSpecified="[com.gs.fw.common.mithra.util.DefaultInfinityTimestamp.getDefaultInfinity()]"
                   timezoneConversion="convert-to-utc"/>
    <Attribute name="visitId" javaType="long" columnName="VISIT_ID" primaryKey="true" nullable="false"/>
    <Attribute name="petId" javaType="long" columnName="PET_ID"/>
    <Attribute name="vetId" javaType="long" columnName="VET_ID"/>
    <Attribute name="visitTime" javaType="Timestamp" columnName="VISIT_TIME"/>
    <Attribute name="reason" javaType="String" columnName="REASON" maxLength="120"/>
    <Attribute name="diagnosis" javaType="String" columnName="DIAGNOSIS" maxLength="255"/>
    <Attribute name="followUpDate" javaType="Timestamp" columnName="FOLLOW_UP_DATE" nullable="true"/>

</MithraObject>
