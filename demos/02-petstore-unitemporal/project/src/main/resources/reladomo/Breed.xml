<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<MithraObject objectType="transactional" disableForeignKeys="true"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="mithraobject.xsd">
    <PackageName>com.reladynamo.demo.petstore.domain</PackageName>
    <ClassName>Breed</ClassName>
        <DatedTransactionalTemporalDirector>com.gs.fw.common.mithra.behavior.GenericNonAuditedTemporalDirector</DatedTransactionalTemporalDirector>
    <DefaultTable>BREED</DefaultTable>
    <AsOfAttribute name="businessDate" fromColumnName="FROM_Z" toColumnName="THRU_Z"
                   toIsInclusive="false" isProcessingDate="false"
                   infinityDate="[com.gs.fw.common.mithra.util.DefaultInfinityTimestamp.getDefaultInfinity()]"
                   timezoneConversion="convert-to-utc"/>
    <Attribute name="breedId" javaType="long" columnName="BREED_ID" primaryKey="true" nullable="false"/>
    <Attribute name="speciesId" javaType="long" columnName="SPECIES_ID"/>
    <Attribute name="name" javaType="String" columnName="NAME" maxLength="80"/>
    <Attribute name="sizeCategory" javaType="String" columnName="SIZE_CATEGORY" maxLength="32"/>
    <Attribute name="typicalLifespanYears" javaType="int" columnName="TYPICAL_LIFESPAN_YEARS"/>

</MithraObject>
