<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<MithraObject objectType="transactional" disableForeignKeys="true"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="mithraobject.xsd">
    <PackageName>com.reladynamo.demo.petstore.domain</PackageName>
    <ClassName>SalesOrder</ClassName>
        <DatedTransactionalTemporalDirector>com.gs.fw.common.mithra.behavior.AuditOnlyTemporalDirector</DatedTransactionalTemporalDirector>
    <DefaultTable>SALES_ORDER</DefaultTable>
    <AsOfAttribute name="processingDate" fromColumnName="IN_Z" toColumnName="OUT_Z"
                   toIsInclusive="false" isProcessingDate="true"
                   infinityDate="[com.gs.fw.common.mithra.util.DefaultInfinityTimestamp.getDefaultInfinity()]"
                   defaultIfNotSpecified="[com.gs.fw.common.mithra.util.DefaultInfinityTimestamp.getDefaultInfinity()]"
                   timezoneConversion="convert-to-utc"/>
    <Attribute name="orderId" javaType="long" columnName="ORDER_ID" primaryKey="true" nullable="false"/>
    <Attribute name="customerId" javaType="long" columnName="CUSTOMER_ID"/>
    <Attribute name="storeId" javaType="long" columnName="STORE_ID"/>
    <Attribute name="orderTime" javaType="Timestamp" columnName="ORDER_TIME"/>
    <Attribute name="status" javaType="String" columnName="STATUS" maxLength="32"/>
    <Attribute name="totalAmount" javaType="BigDecimal" columnName="TOTAL_AMOUNT" precision="18" scale="2"/>
    <Relationship name="lines" relatedObject="SalesOrderLine" cardinality="one-to-many" reverseRelationshipName="order" foreignKey="false">SalesOrderLine.orderId = this.orderId</Relationship>
    <Relationship name="payments" relatedObject="Payment" cardinality="one-to-many" reverseRelationshipName="order" foreignKey="false">Payment.orderId = this.orderId</Relationship>
    <Relationship name="store" relatedObject="Store" cardinality="many-to-one" reverseRelationshipName="salesOrders" foreignKey="false">Store.storeId = this.storeId</Relationship>
    <Relationship name="customer" relatedObject="PetOwner" cardinality="many-to-one" reverseRelationshipName="salesOrders" foreignKey="false">PetOwner.ownerId = this.customerId</Relationship>

</MithraObject>
