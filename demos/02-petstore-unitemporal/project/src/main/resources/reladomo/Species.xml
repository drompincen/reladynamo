<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<MithraObject objectType="transactional" disableForeignKeys="true"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="mithraobject.xsd">
    <PackageName>com.reladynamo.demo.petstore.domain</PackageName>
    <ClassName>Species</ClassName>
        <DatedTransactionalTemporalDirector>com.gs.fw.common.mithra.behavior.GenericNonAuditedTemporalDirector</DatedTransactionalTemporalDirector>
    <DefaultTable>SPECIES</DefaultTable>
    <AsOfAttribute name="businessDate" fromColumnName="FROM_Z" toColumnName="THRU_Z"
                   toIsInclusive="false" isProcessingDate="false"
                   infinityDate="[com.gs.fw.common.mithra.util.DefaultInfinityTimestamp.getDefaultInfinity()]"
                   timezoneConversion="convert-to-utc"/>
    <Attribute name="speciesId" javaType="long" columnName="SPECIES_ID" primaryKey="true" nullable="false"/>
    <Attribute name="commonName" javaType="String" columnName="COMMON_NAME" maxLength="80"/>
    <Attribute name="scientificName" javaType="String" columnName="SCIENTIFIC_NAME" maxLength="120"/>
    <Attribute name="careLevel" javaType="String" columnName="CARE_LEVEL" maxLength="32"/>
    <Relationship name="breeds" relatedObject="Breed" cardinality="one-to-many" reverseRelationshipName="species" foreignKey="false">Breed.speciesId = this.speciesId</Relationship>

</MithraObject>
