<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<MithraObject objectType="transactional" disableForeignKeys="true"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="mithraobject.xsd">
    <PackageName>com.reladynamo.demo.petstore.domain</PackageName>
    <ClassName>StockLevel</ClassName>
        <DatedTransactionalTemporalDirector>com.gs.fw.common.mithra.behavior.GenericNonAuditedTemporalDirector</DatedTransactionalTemporalDirector>
    <DefaultTable>STOCK_LEVEL</DefaultTable>
    <AsOfAttribute name="businessDate" fromColumnName="FROM_Z" toColumnName="THRU_Z"
                   toIsInclusive="false" isProcessingDate="false"
                   infinityDate="[com.gs.fw.common.mithra.util.DefaultInfinityTimestamp.getDefaultInfinity()]"
                   timezoneConversion="convert-to-utc"/>
    <Attribute name="stockId" javaType="long" columnName="STOCK_ID" primaryKey="true" nullable="false"/>
    <Attribute name="storeId" javaType="long" columnName="STORE_ID"/>
    <Attribute name="productId" javaType="long" columnName="PRODUCT_ID"/>
    <Attribute name="quantityOnHand" javaType="int" columnName="QUANTITY_ON_HAND"/>
    <Attribute name="reorderPoint" javaType="int" columnName="REORDER_POINT"/>
    <Relationship name="store" relatedObject="Store" cardinality="many-to-one" reverseRelationshipName="stockLevels" foreignKey="false">Store.storeId = this.storeId</Relationship>

</MithraObject>
