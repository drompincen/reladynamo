<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<MithraObject objectType="transactional" disableForeignKeys="true"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="mithraobject.xsd">
    <PackageName>com.reladynamo.demo.petstore.domain</PackageName>
    <ClassName>SalesOrderLine</ClassName>
        <DatedTransactionalTemporalDirector>com.gs.fw.common.mithra.behavior.AuditOnlyTemporalDirector</DatedTransactionalTemporalDirector>
    <DefaultTable>SALES_ORDER_LINE</DefaultTable>
    <AsOfAttribute name="processingDate" fromColumnName="IN_Z" toColumnName="OUT_Z"
                   toIsInclusive="false" isProcessingDate="true"
                   infinityDate="[com.gs.fw.common.mithra.util.DefaultInfinityTimestamp.getDefaultInfinity()]"
                   defaultIfNotSpecified="[com.gs.fw.common.mithra.util.DefaultInfinityTimestamp.getDefaultInfinity()]"
                   timezoneConversion="convert-to-utc"/>
    <Attribute name="lineId" javaType="long" columnName="LINE_ID" primaryKey="true" nullable="false"/>
    <Attribute name="orderId" javaType="long" columnName="ORDER_ID"/>
    <Attribute name="productId" javaType="long" columnName="PRODUCT_ID" nullable="true"/>
    <Attribute name="petId" javaType="long" columnName="PET_ID" nullable="true"/>
    <Attribute name="quantity" javaType="int" columnName="QUANTITY"/>
    <Attribute name="unitPrice" javaType="BigDecimal" columnName="UNIT_PRICE" precision="18" scale="2"/>
    <Relationship name="product" relatedObject="Product" cardinality="many-to-one" foreignKey="false">Product.productId = this.productId</Relationship>
    <Relationship name="pet" relatedObject="Pet" cardinality="many-to-one" foreignKey="false">Pet.petId = this.petId</Relationship>

</MithraObject>
