<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<MithraObject objectType="transactional" disableForeignKeys="true"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:noNamespaceSchemaLocation="mithraobject.xsd">
    <PackageName>com.reladynamo.demo.petstore.domain</PackageName>
    <ClassName>Pet</ClassName>
        <DatedTransactionalTemporalDirector>com.gs.fw.common.mithra.behavior.GenericNonAuditedTemporalDirector</DatedTransactionalTemporalDirector>
    <DefaultTable>PET</DefaultTable>
    <AsOfAttribute name="businessDate" fromColumnName="FROM_Z" toColumnName="THRU_Z"
                   toIsInclusive="false" isProcessingDate="false"
                   infinityDate="[com.gs.fw.common.mithra.util.DefaultInfinityTimestamp.getDefaultInfinity()]"
                   timezoneConversion="convert-to-utc"/>
    <Attribute name="petId" javaType="long" columnName="PET_ID" primaryKey="true" nullable="false"/>
    <Attribute name="name" javaType="String" columnName="NAME" maxLength="80"/>
    <Attribute name="speciesId" javaType="long" columnName="SPECIES_ID"/>
    <Attribute name="breedId" javaType="long" columnName="BREED_ID" nullable="true"/>
    <Attribute name="dateOfBirth" javaType="Timestamp" columnName="DATE_OF_BIRTH"/>
    <Attribute name="sex" javaType="String" columnName="SEX" maxLength="16"/>
    <Attribute name="colorCode" javaType="String" columnName="COLOR_CODE" maxLength="32"/>
    <Attribute name="microchipId" javaType="String" columnName="MICROCHIP_ID" nullable="true" maxLength="64"/>
    <Attribute name="status" javaType="String" columnName="STATUS" maxLength="32"/>
    <Attribute name="kennelId" javaType="long" columnName="KENNEL_ID" nullable="true"/>
    <Attribute name="listPrice" javaType="BigDecimal" columnName="LIST_PRICE" precision="18" scale="2"/>
    <Relationship name="species" relatedObject="Species" cardinality="many-to-one" reverseRelationshipName="pets" foreignKey="false">Species.speciesId = this.speciesId</Relationship>
    <Relationship name="breed" relatedObject="Breed" cardinality="many-to-one" reverseRelationshipName="pets" foreignKey="false">Breed.breedId = this.breedId</Relationship>
    <Relationship name="kennel" relatedObject="Kennel" cardinality="many-to-one" reverseRelationshipName="pets" foreignKey="false">Kennel.kennelId = this.kennelId</Relationship>
    <Relationship name="feedingSchedules" relatedObject="FeedingSchedule" cardinality="one-to-many" reverseRelationshipName="pet" foreignKey="false">FeedingSchedule.petId = this.petId</Relationship>
    <Relationship name="veterinaryVisits" relatedObject="VeterinaryVisit" cardinality="one-to-many" reverseRelationshipName="pet" foreignKey="false">VeterinaryVisit.petId = this.petId</Relationship>
    <Relationship name="vaccinations" relatedObject="Vaccination" cardinality="one-to-many" reverseRelationshipName="pet" foreignKey="false">Vaccination.petId = this.petId</Relationship>
    <Relationship name="groomingAppointments" relatedObject="GroomingAppointment" cardinality="one-to-many" reverseRelationshipName="pet" foreignKey="false">GroomingAppointment.petId = this.petId</Relationship>
    <Relationship name="adoptions" relatedObject="Adoption" cardinality="one-to-many" reverseRelationshipName="pet" foreignKey="false">Adoption.petId = this.petId</Relationship>

</MithraObject>
